#Requires AutoHotkey v2.1-alpha.26+ 64-bit
#Import "..\..\..\Foundation\HANDLE.ahk" { HANDLE }
#Import "..\..\..\Foundation\NTSTATUS.ahk" { NTSTATUS }
#Import ".\SecBuffer.ahk" { SecBuffer }

/**
 * Imports a security context from another process.
 * @remarks
 * SSP/APs must implement the <b>SpImportSecurityContext</b> function; however, the actual name given to the implementation is up to the developer.
 * 
 * A pointer to the <b>SpImportSecurityContext</b> function is available in the 
 * <a href="https://docs.microsoft.com/windows/desktop/api/ntsecpkg/ns-ntsecpkg-secpkg_user_function_table">SECPKG_USER_FUNCTION_TABLE</a> structure received from the 
 * <a href="https://docs.microsoft.com/windows/desktop/api/ntsecpkg/nc-ntsecpkg-spusermodeinitializefn">SpUserModeInitialize</a> function.
 * @see https://learn.microsoft.com/windows/win32/api/ntsecpkg/nc-ntsecpkg-spimportsecuritycontextfn
 * @namespace Windows.Win32.Security.Authentication.Identity
 */
export default struct SpImportSecurityContextFn {
    value : IntPtr

    __value {
        set {
            if (value is SpImportSecurityContextFn) {
                this.value := value.value
            }
            else {
                this.value := value
            }
        }
    }

    /**
     * 
     * @param {Pointer<SecBuffer>} pPackedContext Pointer to a 
     * <a href="https://docs.microsoft.com/windows/desktop/api/sspi/ns-sspi-secbuffer">SecBuffer</a> structure containing a <a href="https://docs.microsoft.com/windows/desktop/SecGloss/s-gly">serialized</a> <a href="https://docs.microsoft.com/windows/desktop/SecGloss/s-gly">security context</a> previously generated by the 
     * <a href="https://docs.microsoft.com/windows/desktop/api/ntsecpkg/nc-ntsecpkg-spexportsecuritycontextfn">SpExportSecurityContext</a> function.
     * @param {HANDLE} Token Optional. Handle to the context token.
     * @param {Pointer<Pointer>} phContext Pointer to an <b>LSA_SEC_HANDLE</b> that receives the imported context handle.
     * @returns {NTSTATUS} If the function succeeds, return STATUS_SUCCESS.
     * 
     * If the function fails, return an <b>NTSTATUS</b> code that indicates the reason it failed.
     */
    Call(pPackedContext, Token, phContext) {
        phContextMarshal := phContext is VarRef ? "ptr*" : "ptr"

        result := DllCall(this.value, SecBuffer.Ptr, pPackedContext, HANDLE, Token, phContextMarshal, phContext, NTSTATUS)
        NTSTATUS.ThrowIfError(result.value)
        return result
    }

    /**
     * A SpImportSecurityContextFn that invokes the given AHK function when called.
     * This callback is owned by the script and cleaned up automatically.
     */
    struct From extends SpImportSecurityContextFn {
        /**
         * Creates a SpImportSecurityContextFn pointer that invokes the given AHK function when called.
         * @param {Func(SecBuffer, HANDLE, "ptr*") => NTSTATUS} fn the function to invoke.
         */
        __New(fn) {
            if (!HasMethod(fn, , 3)) {
                throw MethodError("Object of type " Type(fn) " is not callable with 3 parameters.", -1, fn)
            }
            this.value := CallbackCreate(fn, , [SecBuffer.Ptr, HANDLE, "ptr*", NTSTATUS])
        }

        __Delete() {
            if (this.value) {
                CallbackFree(this.value)
            }
        }
    }
}
